// Plateforme de réservation VTC en clientèle privée — schéma de données.
// Multi-tenant par `driverId` (row-level). Tous les montants sont en CENTIMES (Int), EUR.
// La synchronisation Google Calendar (V1.5/V2) est prévue dans le modèle mais non implémentée.

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev local ; "rhel-openssl-3.0.x" pour l'environnement Vercel (Amazon Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────────────────────────────────────
// Authentification & comptes
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  DRIVER
}

/// Compte de connexion au back-office (admin Chams ou chauffeur).
/// Le client final n'a PAS de compte (liens signés par email).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(DRIVER)
  driver       Driver?  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId     String?  @unique

  passwordResetToken  String?   @unique
  passwordResetExpiry DateTime?

  // Vérification de l'adresse email (confirmée par un lien envoyé à l'inscription).
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?   @unique
  emailVerificationExpiry DateTime?
  emailVerificationSentAt DateTime? // horodatage du dernier envoi (throttle du renvoi)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Chauffeur (tenant) & configuration
// ─────────────────────────────────────────────────────────────────────────────

enum DriverStatus {
  PENDING // créé, onboarding incomplet
  ACTIVE
  SUSPENDED
}

/// Moyens de paiement qu'un chauffeur peut accepter. Il choisit librement
/// lesquels activer dans ses réglages : prépaiement en ligne et/ou
/// encaissement sur place le jour de la course (carte, espèces, chèque).
enum PaymentMethod {
  STRIPE_PREPAYMENT // paiement en avance par carte en ligne (Stripe ou SumUp selon le prestataire actif)
  ONSITE_CARD       // carte bancaire sur place (terminal du chauffeur)
  ONSITE_CASH       // espèces sur place
  ONSITE_CHECK      // chèque sur place
}

enum PaymentProvider {
  STRIPE
  SUMUP
}

/// Un chauffeur = un tenant. Sa page publique est servie sur /{slug}.
model Driver {
  id     String       @id @default(cuid())
  slug   String       @unique
  status DriverStatus @default(PENDING)

  // Présentation publique (marque blanche)
  displayName  String
  tagline      String?
  bio          String? @db.Text
  photoUrl     String?
  vehicleMake  String?
  vehicleModel String?
  vehicleClass String? // Berline, Van, Premium...
  vehicleSeats Int?
  services     String? @db.Text // description libre des prestations
  serviceArea  String? @db.Text // zone desservie (texte)
  phone        String?
  contactEmail String?

  // Identité légale
  siren         String?
  sirenVerified Boolean @default(false)
  companyName   String?

  // Prestataire de paiement actif pour ce chauffeur.
  paymentProvider PaymentProvider @default(SUMUP)

  // Paiement (Stripe Connect Express)
  stripeAccountId       String? @unique
  stripeOnboarded       Boolean @default(false)
  stripePayoutsEnabled  Boolean @default(false)
  stripeChargesEnabled  Boolean @default(false)

  // Paiement (SumUp — le chauffeur est merchant of record, encaisse en direct).
  // Deux modes de connexion : OAuth (jetons + refresh), ou clé API générée par le
  // chauffeur dans son espace SumUp (utilisée tant que le scope OAuth `payments`
  // n'est pas accordé à l'app). Secrets stockés CHIFFRÉS (AES-256-GCM via
  // SUMUP_TOKEN_ENCRYPTION_KEY). Si `sumupApiKey` est présente, elle prime.
  sumupMerchantCode    String?   @unique
  sumupAccessToken     String?   @db.Text // chiffré
  sumupRefreshToken    String?   @db.Text // chiffré
  sumupTokenExpiresAt  DateTime?
  sumupApiKey          String?   @db.Text // chiffré
  sumupConnected       Boolean   @default(false)

  // Notifications
  telegramChatId String?
  telegramLinkCode String? @unique // code d'appairage du bot

  // Moyens de paiement acceptés (choisis par le chauffeur dans ses réglages).
  // Par défaut : prépaiement Stripe. Le chauffeur peut tout encaisser sur place
  // (carte / espèces / chèque) sans passer par le prépaiement s'il le souhaite.
  paymentMethods PaymentMethod[] @default([STRIPE_PREPAYMENT])

  // Confirmation automatique des réservations : si le créneau est libre, la course
  // est confirmée dès la demande, sans validation manuelle — par le paiement en
  // ligne quand il est exigé/choisi, ou immédiatement quand le règlement se fait
  // sur place. En cas de conflit calendrier (ou de paiement en ligne inopérant
  // alors qu'il est exigé), la demande repasse en validation manuelle.
  autoAcceptQuotes Boolean @default(false)

  // Paramètres métier (centimes / minutes)
  currency             String @default("eur")
  minimumFareCents     Int    @default(2500) // prix minimum de course
  minLeadTimeMinutes   Int    @default(120)  // délai mini de réservation (ex: 2h)
  quoteExpiryHours     Int    @default(24)   // durée de validité d'un devis
  approachBufferMinutes Int   @default(30)   // trajet d'approche estimé bloqué au calendrier
  commissionBps        Int    @default(0)    // commission plateforme en points de base (0 = 0%)
  timezone             String @default("Europe/Paris")
  locale               String @default("fr")

  // Relations
  user             User?
  transferBands    TransferRateBand[]
  hourlyTiers      HourlyRateTier[]
  surcharges       Surcharge[]
  vehicles         Vehicle[]
  cancellationPolicy CancellationPolicy?
  customers        Customer[]
  rideRequests     RideRequest[]
  quotes           Quote[]
  bookings         Booking[]
  calendarEvents   CalendarEvent[]
  payments         Payment[]
  subscription     Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

/// Un véhicule de la flotte d'un chauffeur. Un chauffeur peut en déclarer plusieurs.
/// `make`/`modelFamily` correspondent aux paramètres du catalogue/CDN d'images
/// (imagin.studio) afin d'afficher une photo cohérente du modèle. `modelLabel` est
/// le libellé lisible (ex: "Mercedes Classe V"). Les photos partagent le même angle
/// et le même fond pour garantir la cohérence visuelle de la page publique.
model Vehicle {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  make        String  // marque normalisée pour le CDN (ex: "mercedes")
  modelFamily String  // famille de modèle pour le CDN (ex: "v-class")
  modelLabel  String  // libellé affiché (ex: "Mercedes Classe V")
  vehicleClass String? // Berline, Van, SUV, Premium…
  seats       Int?
  color       String? // couleur libre (ex: "Noir")
  isPrimary   Boolean @default(false) // véhicule mis en avant
  position    Int     @default(0)     // ordre d'affichage

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Grilles tarifaires
// ─────────────────────────────────────────────────────────────────────────────

/// Transfert A→B : tarif €/km variable selon l'horaire (jour / nuit / heures de pointe).
/// Chaque bande couvre des jours de la semaine et une plage horaire ; on choisit
/// la bande applicable au départ de la course selon `priority` (plus haut = prioritaire).
model TransferRateBand {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  name           String // "Jour", "Nuit", "Heures de pointe"...
  pricePerKmCents Int
  // Jours de semaine couverts (0 = dimanche ... 6 = samedi). Vide = tous les jours.
  daysOfWeek     Int[]  @default([])
  startMinute    Int    @default(0)    // minute de début dans la journée (0..1439)
  endMinute      Int    @default(1440) // minute de fin (exclue, peut être > 1440 pour chevaucher minuit)
  priority       Int    @default(0)
  isDefault      Boolean @default(false) // bande de repli si aucune autre ne matche

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
}

/// Mise à disposition : tarif horaire dégressif par paliers de durée.
/// Ex: minHours=1 -> 6000 c/h ; minHours=4 -> 5500 c/h. On applique le palier
/// dont `minHours` est le plus grand <= durée demandée.
model HourlyRateTier {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  minHours        Int // seuil de durée (heures) à partir duquel ce tarif s'applique
  pricePerHourCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, minHours])
  @@index([driverId])
}

enum SurchargeKind {
  FIXED   // montant fixe en centimes
  PERCENT // pourcentage du sous-total (en points de base)
}

/// Majorations optionnelles (bagages, aéroport, jours fériés...).
model Surcharge {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  name      String
  kind      SurchargeKind
  amount    Int // centimes si FIXED, points de base si PERCENT
  autoApply Boolean @default(false) // appliquée automatiquement à toute course

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
}

/// Politique d'annulation paramétrable (par chauffeur).
model CancellationPolicy {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String @unique

  freeUntilHours  Int @default(24) // annulation gratuite jusqu'à X h avant la course
  retainedPercent Int @default(50) // % retenu si annulation tardive (0..100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Clientèle privée
// ─────────────────────────────────────────────────────────────────────────────

/// Base clients du chauffeur = « portefeuille clientèle privée ».
model Customer {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  name  String
  phone String
  // Optionnel : un client ajouté par le chauffeur (bouton « Partager ma page »)
  // via SMS/WhatsApp peut n'avoir qu'un téléphone. Le flux de réservation public,
  // lui, exige toujours l'email (validation côté API). Dédoublonnage : par email
  // pour les réservations, par téléphone pour l'ajout manuel.
  email String?

  rideRequests RideRequest[]
  bookings     Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([driverId, email])
  @@index([driverId])
  @@index([driverId, phone])
}

// ─────────────────────────────────────────────────────────────────────────────
// Demande de course → Devis → Réservation
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceType {
  TRANSFER // A → B (option aller-retour)
  HOURLY   // mise à disposition
}

enum RideRequestStatus {
  PENDING   // soumise par le client, en attente de devis chauffeur
  QUOTED    // un devis a été émis
  CANCELLED
}

model RideRequest {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  type   ServiceType
  status RideRequestStatus @default(PENDING)

  // Coordonnées client (capturées même si Customer pas encore créé)
  customerName  String
  customerPhone String
  customerEmail String

  scheduledAt DateTime // date/heure de prise en charge souhaitée

  // Transfert
  pickupAddress  String?
  pickupLat      Float?
  pickupLng      Float?
  dropoffAddress String?
  dropoffLat     Float?
  dropoffLng     Float?
  roundTrip      Boolean @default(false)
  distanceMeters Int?    // calculé via Google Routes
  durationSeconds Int?   // calculé via Google Routes

  // Mise à disposition
  durationHours Int?

  notes String? @db.Text

  // Moyen de règlement choisi par le client dès le formulaire public (null si
  // non précisé — ancien formulaire en cache, ou choix reporté à la page devis).
  preferredPaymentMethod PaymentMethod?

  quotes Quote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, status])
}

enum QuoteStatus {
  DRAFT     // calculé automatiquement, pas encore validé par le chauffeur
  SENT      // validé/ajusté par le chauffeur, envoyé au client
  ACCEPTED  // payé → réservation confirmée
  EXPIRED
  REJECTED  // refusé par le chauffeur
  CANCELLED
}

model Quote {
  id            String      @id @default(cuid())
  driver        Driver      @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId      String
  rideRequest   RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  rideRequestId String

  status QuoteStatus @default(DRAFT)

  // Montants (centimes). `amountCents` est le prix final facturé au client.
  computedAmountCents Int  // prix calculé automatiquement par le moteur
  amountCents         Int  // prix final (ajusté éventuellement par le chauffeur)
  breakdown           Json // détail du calcul (lignes, taux appliqués)
  currency            String @default("eur")

  // Part chauffeur / commission plateforme (destination charges)
  applicationFeeCents Int @default(0)

  // Id du Hosted Checkout SumUp en cours (permet au webhook de retrouver le devis).
  sumupCheckoutId String? @unique

  expiresAt   DateTime
  sentAt      DateTime?
  acceptedAt  DateTime?

  // Jeton signé pour les actions client (voir devis, payer) — défense en profondeur
  // en plus du JWT signé envoyé par email.
  publicToken String @unique @default(cuid())

  booking Booking?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, status])
  @@index([rideRequestId])
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Booking {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String @unique

  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String

  status BookingStatus @default(PENDING_PAYMENT)

  scheduledAt DateTime
  amountCents Int

  // Jeton signé permettant au client de modifier/annuler depuis son email.
  manageToken String @unique @default(cuid())

  calendarEvent CalendarEvent?
  payments      Payment[]
  refunds       Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, status])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendrier (interne en V1, prêt pour la sync Google en V1.5/V2)
// ─────────────────────────────────────────────────────────────────────────────

enum CalendarEventType {
  BOOKING        // course confirmée (inclut le trajet d'approche dans la plage)
  UNAVAILABILITY // indisponibilité saisie par le chauffeur (jour off, RDV perso)
  WORKING_BLOCK  // plage de travail (informatif)
}

enum CalendarSource {
  INTERNAL
  GOOGLE
}

model CalendarEvent {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  type   CalendarEventType
  source CalendarSource    @default(INTERNAL)

  // Identifiant de l'événement côté Google (rempli lors de la sync future).
  externalEventId String?

  title  String?
  startAt DateTime
  endAt   DateTime

  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId, startAt, endAt])
  @@index([source, externalEventId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Paiements & remboursements (Stripe)
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String

  provider PaymentProvider @default(SUMUP)

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeChargeId          String?

  // SumUp : id du checkout hébergé + code de la transaction aboutie.
  sumupCheckoutId       String? @unique
  sumupTransactionCode  String?

  amountCents         Int
  applicationFeeCents Int @default(0)
  currency            String @default("eur")
  status              PaymentStatus @default(PENDING)
  // Moyen par lequel ce paiement est (ou sera) encaissé. Pour un encaissement
  // sur place, le paiement reste PENDING jusqu'à ce que le chauffeur le marque reçu.
  method              PaymentMethod @default(STRIPE_PREPAYMENT)

  refunds Refund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([bookingId])
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id        String  @id @default(cuid())
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  paymentId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String

  stripeRefundId String? @unique
  sumupRefundTxId String? @unique
  amountCents    Int
  reason         String?
  status         RefundStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Idempotence des webhooks & facturation des forfaits
// ─────────────────────────────────────────────────────────────────────────────

/// Garantit le traitement unique d'un événement webhook (Stripe, Telegram).
model WebhookEvent {
  id         String   @id // identifiant de l'événement fournisseur (ex: evt_...)
  provider   String   // "stripe" | "telegram"
  type       String
  receivedAt DateTime @default(now())
  processedAt DateTime?

  @@index([provider, type])
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

/// Forfait mensuel fixe facturé par Chams au chauffeur (suivi interne).
model Subscription {
  id       String @id @default(cuid())
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  driverId String @unique

  planName        String @default("Standard")
  monthlyFeeCents Int    @default(0)
  status          SubscriptionStatus @default(ACTIVE)
  startedAt       DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
