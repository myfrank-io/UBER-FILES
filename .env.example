# ──────────────────────────────────────────────────────────────────────────
# Plateforme de réservation VTC — variables d'environnement
# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Aucune clé secrète ci-dessous n'est exposée au navigateur.
# ──────────────────────────────────────────────────────────────────────────

# URL publique de l'application (utilisée dans les emails, liens de paiement, webhooks)
APP_BASE_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL=postgresql://vtc:vtc@localhost:5432/vtc?schema=public

# Secret de session (nuxt-auth-utils) — min. 32 caractères aléatoires
# Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD=changeme-please-generate-a-32-char-secret

# Secret de signature des liens client (devis / gestion de réservation)
# Générer : openssl rand -base64 32
LINK_TOKEN_SECRET=changeme-please-generate-a-32-char-secret

# ── Stripe (mode test par défaut) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx          # webhook paiements (checkout/payment_intent)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx  # webhook comptes connectés (account.updated)

# ── Google Maps Platform (Places Autocomplete + Routes) ──
# Clé serveur, restreinte par API. JAMAIS exposée au client.
GOOGLE_MAPS_API_KEY=

# ── Resend (email transactionnel) ──
RESEND_API_KEY=
EMAIL_FROM=Réservation VTC <onboarding@resend.dev>

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=changeme-telegram-webhook-secret

# ── API Sirene INSEE (vérification SIREN à l'onboarding) ──
INSEE_API_KEY=

# ── Tâches planifiées (rappels J-1) ──
# Secret protégeant POST /api/cron/reminders (appelé par un cron externe / GitHub Action)
CRON_SECRET=changeme-cron-secret
