# ──────────────────────────────────────────────────────────────────────────
# Plateforme de réservation VTC — variables d'environnement
# Copiez ce fichier en `.env` et renseignez vos valeurs.
# Aucune clé secrète ci-dessous n'est exposée au navigateur.
# ──────────────────────────────────────────────────────────────────────────

# URL publique de l'application (utilisée dans les emails, liens de paiement, webhooks)
APP_BASE_URL=http://localhost:3000

# Base de données PostgreSQL
DATABASE_URL=postgresql://vtc:vtc@localhost:5432/vtc?schema=public
# Connexion directe (sans pooler) utilisée par les migrations Prisma.
# En local : la même valeur que DATABASE_URL. Sur Neon : la chaîne SANS "-pooler".
DATABASE_URL_UNPOOLED=postgresql://vtc:vtc@localhost:5432/vtc?schema=public

# Secret de session (nuxt-auth-utils) — min. 32 caractères aléatoires
# Générer : openssl rand -base64 32
NUXT_SESSION_PASSWORD=changeme-please-generate-a-32-char-secret

# Secret de signature des liens client (devis / gestion de réservation)
# Générer : openssl rand -base64 32
LINK_TOKEN_SECRET=changeme-please-generate-a-32-char-secret

# ── Stripe (mode test par défaut) ──
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx          # webhook paiements (checkout/payment_intent)
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx  # webhook comptes connectés (account.updated)

# ── SumUp (OAuth ou clé API + Hosted Checkout) ──
# App OAuth créée sur le portail développeur SumUp (Settings → For Developers → OAuth2 Apps).
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
# Doit matcher EXACTEMENT une "Authorized redirect URL" déclarée sur l'app OAuth.
SUMUP_REDIRECT_URI=http://localhost:3000/api/payments/sumup/callback
SUMUP_WEBHOOK_SECRET=                     # secret de vérification du webhook SumUp (optionnel au départ)
# Clé de chiffrement des secrets SumUp chauffeurs (jetons OAuth / clés API).
# Générer : openssl rand -base64 32
SUMUP_TOKEN_ENCRYPTION_KEY=
# Bouton de connexion OAuth dans les réglages chauffeur. Laisser à 0 tant que le
# scope restreint `payments` n'a pas été accordé à l'app par le support SumUp :
# les chauffeurs se connectent alors en collant une clé API de leur espace SumUp.
SUMUP_OAUTH_ENABLED=0

# ── Google Maps Platform (Places Autocomplete + Text Search + Routes) ──
# Clé serveur, restreinte par API. JAMAIS exposée au client.
# Text Search sert à retrouver la fiche Google du chauffeur (lien d'avis) :
# couvert par « Places API (New) », déjà requise pour l'autocomplétion.
GOOGLE_MAPS_API_KEY=

# ── Images de véhicules (imagin.studio) ──
# Clé client du CDN qui rend les photos de modèles (même angle / même fond).
# Vide = clé démo gratuite par défaut. En production, renseignez votre propre
# clé imagin.studio. Exposée au client (préfixe public), donc non sensible.
IMAGIN_CUSTOMER=

# ── Resend (email transactionnel) ──
RESEND_API_KEY=
EMAIL_FROM=Réservation VTC <onboarding@resend.dev>

# ── Telegram Bot ──
# Chaque chauffeur active Telegram depuis ses réglages (lie son compte au bot).
# L'email reste envoyé dans tous les cas ; Telegram s'ajoute pour les comptes liés.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=changeme-telegram-webhook-secret
# Username du bot (sans @), ex. RideWizBot — sert au lien d'appairage t.me/<bot>?start=…
TELEGRAM_BOT_USERNAME=

# ── API Sirene INSEE (vérification SIREN à l'onboarding) ──
INSEE_API_KEY=

# ── Tâches planifiées (rappels J-1) ──
# Secret protégeant POST /api/cron/reminders (appelé par un cron externe / GitHub Action)
CRON_SECRET=changeme-cron-secret

# ── Seed admin ──
# Mot de passe du compte admin créé par `npm run db:seed` (uniquement à la 1re
# création — un seed ne réécrase jamais un mot de passe existant). Si vide, un
# mot de passe aléatoire est généré et affiché dans les logs du seed.
# NE JAMAIS committer la vraie valeur.
ADMIN_SEED_PASSWORD=

# ── Sécurité ──
# Origines autorisées pour les requêtes CORS (en prod = domaine Vercel ou custom)
# Déjà dérivé de APP_BASE_URL — laisser vide sauf besoin spécifique
# ALLOWED_ORIGINS=https://mondomaine.fr

# ── Optionnel (monitoring) ──
# SENTRY_DSN=https://xxx@sentry.io/yyy
